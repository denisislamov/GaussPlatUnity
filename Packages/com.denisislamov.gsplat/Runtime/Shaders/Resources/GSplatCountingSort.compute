// Depth sort of the visible splats on the GPU as a 16-bit counting sort, written for the lowest common
// denominator: no wave/subgroup intrinsics (that is what ties gsplat-unity to D3D12/Metal/Vulkan), thread groups
// of 128 (the OpenGL ES 3.1 minimum) and only groupshared memory + InterlockedAdd. Four kernels, run in order:
//   ClearHistogram -> ComputeKeys -> PrefixSum -> Scatter
// Positions come straight from the packed splat texture (no second copy), work is one thread per slot of the
// visible chunks (65 536 slots per chunk; the tail of a partial chunk is skipped with EMPTY_KEY), and the result
// goes into the RGBA8 order texture the vertex shader reads (see ISplatSorter.cs for why a texture).
// Ascending key = back to front (SplatSortKeys.cs; the CPU sorter shares the definition).

#pragma kernel ClearHistogram
#pragma kernel ComputeKeys
#pragma kernel PrefixSum
#pragma kernel Scatter

#include "../GSplatCore.hlsl"

#define BUCKET_COUNT 65536
#define MAX_KEY 65535
#define EMPTY_KEY 0xFFFFFFFFu
#define THREADS 128
#define BUCKETS_PER_THREAD (BUCKET_COUNT / THREADS) // 512
#define CHUNK_SIZE 65536u

// Mirrors SplatChunkInfo (48 bytes): count, padding (float bits), 2 unused, padded bounds min, padded bounds max.
struct ChunkInfo
{
    uint4 countAndPadding;
    float4 boundsMin;
    float4 boundsMax;
};

float3 ChunkPositionMin(ChunkInfo chunk) { return chunk.boundsMin.xyz + asfloat(chunk.countAndPadding.y); }
float3 ChunkPositionExtent(ChunkInfo chunk) { return max(chunk.boundsMax.xyz - asfloat(chunk.countAndPadding.y) - ChunkPositionMin(chunk), 1e-6); }

Texture2D<float4> _Splats;
StructuredBuffer<ChunkInfo> _Chunks;
StructuredBuffer<uint> _VisibleChunks;
RWStructuredBuffer<uint> _Keys;           // per slot: 0..65535 or EMPTY_KEY
RWStructuredBuffer<uint> _Histogram;      // per bucket: count after ComputeKeys, first output slot after PrefixSum
RWTexture2D<float4> _Order;               // RGBA8: slot -> splat index as 4 bytes
RWStructuredBuffer<uint> _DrawArgs;       // indirect draw args; [1] = instance count = splats that got a slot

uint _SlotCount;                          // visible chunks x 65536
float3 _CameraPosition;                   // in the splat object's local space
float3 _CameraForward;
float _LogMinDepth;        // log of the nearest depth of the key range (see SplatSortKeys.cs: log depth keys)
float _InverseLogDepthRange;
int _CullInKeys;                          // 1 = skip splats that cannot produce pixels (SplatVisibility.cs twin below)
int _SortRadial;                          // 1 = order by distance to the camera (Spark), 0 = by view depth
float4x4 _LocalToClip;
float _FocalPixelsY;
float2 _ScreenSize;
float _MaxStdDev;
float _MinPixelRadius;

uint SplatIndexOfSlot(uint slot)
{
    return _VisibleChunks[slot / CHUNK_SIZE] * CHUNK_SIZE + (slot % CHUNK_SIZE);
}

[numthreads(THREADS, 1, 1)]
void ClearHistogram(uint3 id : SV_DispatchThreadID)
{
    if (id.x < BUCKET_COUNT) _Histogram[id.x] = 0;
}

[numthreads(THREADS, 1, 1)]
void ComputeKeys(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _SlotCount) return;

    uint chunkIndex = _VisibleChunks[slot / CHUNK_SIZE];
    uint local = slot % CHUNK_SIZE;
    ChunkInfo chunk = _Chunks[chunkIndex];
    if (local >= chunk.countAndPadding.x)
    {
        _Keys[slot] = EMPTY_KEY;
        return;
    }

    uint splatIndex = chunkIndex * CHUNK_SIZE + local;
    GSplatUnpacked s = GSplatUnpack(GSplatLoadPacked(_Splats, splatIndex));
    float3 position = ChunkPositionMin(chunk) + s.position * ChunkPositionExtent(chunk);
    if (_CullInKeys != 0 && !GSplatKeyPassVisible(position, s.scale, _LocalToClip, _FocalPixelsY, _ScreenSize, _MaxStdDev, _MinPixelRadius))
    {
        _Keys[slot] = EMPTY_KEY;
        return;
    }

    float depth = _SortRadial != 0 ? length(position - _CameraPosition) : dot(position - _CameraPosition, _CameraForward);
    // Log depth: near surfaces get millimeter buckets, the far background centimeters (SplatSortKeys.DepthToKey twin).
    float normalized = saturate((log(max(depth, 0.01)) - _LogMinDepth) * _InverseLogDepthRange);
    uint key = MAX_KEY - (uint)(normalized * MAX_KEY + 0.5);
    _Keys[slot] = key;
    InterlockedAdd(_Histogram[key], 1);
}

// One thread group turns the histogram into an exclusive prefix sum. Each thread owns 512 consecutive
// buckets: it sums them, the 128 partial sums are scanned in groupshared memory (Hillis-Steele, 7 steps),
// then each thread writes the running offsets of its 512 buckets. ~1500 memory operations per thread on a
// single group is a compromise: short in absolute terms (tens of microseconds) and no second dispatch or
// wave intrinsics needed.
groupshared uint partialSums[THREADS];

[numthreads(THREADS, 1, 1)]
void PrefixSum(uint3 groupThreadId : SV_GroupThreadID)
{
    uint thread = groupThreadId.x;
    uint firstBucket = thread * BUCKETS_PER_THREAD;

    uint sum = 0;
    for (uint bucket = 0; bucket < BUCKETS_PER_THREAD; bucket++)
    {
        sum += _Histogram[firstBucket + bucket];
    }
    partialSums[thread] = sum;
    GroupMemoryBarrierWithGroupSync();

    for (uint stride = 1; stride < THREADS; stride <<= 1)
    {
        uint addend = thread >= stride ? partialSums[thread - stride] : 0;
        GroupMemoryBarrierWithGroupSync();
        partialSums[thread] += addend;
        GroupMemoryBarrierWithGroupSync();
    }

    uint running = thread > 0 ? partialSums[thread - 1] : 0;
    for (uint bucket = 0; bucket < BUCKETS_PER_THREAD; bucket++)
    {
        uint count = _Histogram[firstBucket + bucket];
        _Histogram[firstBucket + bucket] = running;
        running += count;
    }

    // The last thread ends with the grand total = number of splats that got a slot = instances to draw.
    if (thread == THREADS - 1) _DrawArgs[1] = running;
}

[numthreads(THREADS, 1, 1)]
void Scatter(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _SlotCount) return;

    uint key = _Keys[slot];
    if (key == EMPTY_KEY) return;

    uint outputSlot;
    InterlockedAdd(_Histogram[key], 1, outputSlot);
    // Splats with equal keys land in arbitrary order; they are at the same quantized depth, so it does not matter.
    uint splatIndex = SplatIndexOfSlot(slot);
    _Order[uint2(outputSlot % GSPLAT_TEXTURE_WIDTH, outputSlot / GSPLAT_TEXTURE_WIDTH)] = GSplatUintToTexel(splatIndex);
}
