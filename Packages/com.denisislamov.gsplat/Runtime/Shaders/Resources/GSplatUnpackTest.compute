// Test helper: reads splats from the packed texture the way the renderer will and writes them out as floats,
// so PackedSplatGpuTests can compare the HLSL unpack with the C# one. Not used at runtime.
#pragma kernel Unpack
#include "../GSplatPacked.hlsl"

Texture2D<float4> _Splats;
StructuredBuffer<float4> _ChunkCenters; // xyz per chunk
RWStructuredBuffer<float4> _Positions;  // xyz world position, w alpha
RWStructuredBuffer<float4> _Scales;     // xyz scale
RWStructuredBuffer<float4> _Rotations;  // xyzw
RWStructuredBuffer<float4> _Colors;     // rgb
uint _SplatCount;

[numthreads(64, 1, 1)]
void Unpack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SplatCount) return;

    GSplatUnpacked s = GSplatUnpack(GSplatLoadPacked(_Splats, id.x));
    float3 center = _ChunkCenters[id.x / 65536u].xyz;
    _Positions[id.x] = float4(s.position + center, s.alpha);
    _Scales[id.x] = float4(s.scale, 0);
    _Rotations[id.x] = s.rotation;
    _Colors[id.x] = float4(s.color, 0);
}
