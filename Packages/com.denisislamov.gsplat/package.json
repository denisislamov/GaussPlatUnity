    "com.unity.inputsystem": "1.19.0",
    "com.unity.ugui": "2.0.0"
  },
  "author": {
    "name": "Denis Islamov"
  },
  "license": "MIT",
  "samples": [
    {
      "displayName": "Viewer Scene",
      "description": "The ready-to-run viewer: fly camera, world loader, UI, debug overlay and menu.",
      "path": "Samples~/Viewer Scene"
    },
    {
      "displayName": "Study Room 100k",
      "description": "A small generated room (100k splats) as an imported asset, with a URP cube.",
      "path": "Samples~/Study Room 100k"
    }
  ],
  "documentationUrl": "https://github.com/denisislamov/GaussPlatUnity/blob/main/README.md",
